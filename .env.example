# Mistral AI Cloud Configuration (comma-separated keys supported for rotation)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=ministral-8b-latest

# Or OpenAI Configuration
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

ZYDRAKON_CLOUD_ENABLED=true
# Default storage: %LOCALAPPDATA%/ZydrakonAI (outside synced Desktop/Documents).
# ZYDRAKON_DATA_DIR=C:/Users/YOUR_USER/AppData/Local/ZydrakonAI
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
ZYDRAKON_JOB_TIMEOUT=120
ZYDRAKON_DAILY_CLOUD_LIMIT=200
